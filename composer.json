{
    "name": "infrangible/m2-cache-usage-hyva",
    "description": "Makes Cache Usage work in stores with the Hyvä theme, so its cache summaries and block markers are displayed correctly on the storefront.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Performance",
        "Developer tools",
        "Hyvä support for Cache Usage",
        "cache usage report for Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-cache-usage-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-cache-usage": "~2.4.0",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CacheUsageHyva\\": "src"
        }
    }
}
